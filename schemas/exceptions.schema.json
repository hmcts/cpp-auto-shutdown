{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schedule exceptions",
  "type": "object",
  "required": ["exceptions"],
  "properties": {
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["request", "reference", "stacks", "start", "end", "window", "requester", "approver", "applied", "justification"],
        "properties": {
          "request": { "type": "integer" },
          "reference": { "type": "string" },
          "stacks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "start": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "end": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "window": { "enum": ["06:00-19:00", "06:00-21:00", "06:00-23:00", "24h"] },
          "requester": { "type": "string" },
          "approver": { "type": ["string", "null"] },
          "applied": { "type": "boolean" },
          "justification": { "type": "string" }
        }
      }
    }
  }
}
